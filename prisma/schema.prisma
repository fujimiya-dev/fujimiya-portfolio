generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Work {
  id          String   @id @default(cuid())
  slug        String   @unique
  numberLabel String? // e.g. "制作物 一" — no longer editable from the admin UI; kept nullable so existing rows aren't lost
  title       String
  dateLabel   String // e.g. "2024.12.20 – 2025.1.17"
  award       String? // e.g. "優勝"
  demoUrl     String? // 実際に試せるデモへのリンク
  githubUrl   String? // リポジトリへのリンク
  summary     String
  description String
  comment     String   @default("準備中") // 製作者コメント
  teamSize    Int      @default(1) // 担当人数
  role        String   @default("準備中") // 担当部分
  youtubeId   String? // 抽出済みのYouTube動画ID(URLそのものではない)
  imageUrl    String? // YouTube動画が無い作品向けのフォールバック表示用
  screenshots String[] // 詳細ページのスクリーンショットギャラリー用(配列の順番=表示順)
  category    String[] // 例: チーム開発, ハッカソン, ビジネス
  techStack   String[] // 例: Python, Django, Unity
  credits     String? // 複数行・URL含む素材クレジット表記(改行保持して表示)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations WorkTranslation[]
}

model WorkTranslation {
  id          String   @id @default(cuid())
  workId      String
  locale      String   @default("en")
  title       String?
  dateLabel   String?
  award       String?
  summary     String?
  description String?
  comment     String?
  role        String?
  credits     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, locale])
}

model Experience {
  id        String   @id @default(cuid())
  org       String
  dateLabel String
  summary   String
  tags      String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ExperienceTranslation[]
}

model ExperienceTranslation {
  id           String     @id @default(cuid())
  experienceId String
  locale       String     @default("en")
  org          String?
  dateLabel    String?
  summary      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
}

model ResearchItem {
  id           String   @id @default(cuid())
  slug         String   @unique
  stage        String // "学部での研究" / "大学院での研究"
  title        String
  summary      String // 詳細ページ用の概要
  cardSummary  String? // 一覧カード用の短い概要(未入力ならsummaryを代わりに表示)
  imageUrl     String?
  caption      String?
  tags         String[]
  techStack    String[] // 使用技術
  references   String[] // 主な参考文献
  achievements String[] // 実績
  paperUrl     String? // 論文URL
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations ResearchItemTranslation[]
}

model ResearchItemTranslation {
  id             String       @id @default(cuid())
  researchItemId String
  locale         String       @default("en")
  title          String?
  summary        String?
  cardSummary    String?
  caption        String?
  achievements   String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  researchItem   ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  @@unique([researchItemId, locale])
}

