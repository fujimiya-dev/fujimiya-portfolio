generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model Work {
  id          String   @id @default(cuid())
  slug        String   @unique
  numberLabel String // e.g. "制作物 一"
  title       String
  dateLabel   String // e.g. "2024.12.20 – 2025.1.17"
  award       String? // e.g. "優勝"
  summary     String
  description String
  comment     String   @default("準備中") // 製作者コメント
  teamSize    Int      @default(1) // 担当人数
  role        String   @default("準備中") // 担当部分
  demoUrl     String?
  imageUrl    String?
  category    String[] // 例: チーム開発, ハッカソン, ビジネス
  techStack   String[] // 例: Python, Django, Unity
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id        String   @id @default(cuid())
  org       String
  dateLabel String
  summary   String
  tags      String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResearchItem {
  id        String   @id @default(cuid())
  stage     String // "学部での研究" / "大学院での研究"
  title     String
  summary   String
  imageUrl  String?
  caption   String?
  tags      String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hobby {
  id    String @id @default(cuid())
  title String
  body  String
  order Int    @default(0)
}

model PianoHistory {
  id          String @id @default(cuid())
  period      String // 例: "2008 – 2012"
  description String
  order       Int    @default(0)
}

model PianoVideo {
  id        String  @id @default(cuid())
  dateLabel String
  venue     String
  piece     String
  note      String? // 例: "有馬由希子氏と連弾"
  videoUrl  String?
  order     Int     @default(0)
}

model ArtFavorite {
  id       String  @id @default(cuid())
  kind     String // "painting" | "museum"
  name     String
  url      String?
  imageUrl String?
  order    Int     @default(0)
}

model GameFavorite {
  id       String  @id @default(cuid())
  group    String // 例: "音楽ゲーム"
  title    String
  url      String?
  imageUrl String?
  order    Int     @default(0)
}
