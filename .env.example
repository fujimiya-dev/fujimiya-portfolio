# Vercel Postgres (Storage タブで作成すると自動で発行される)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob (画像アップロード用。Storage タブで作成)
BLOB_READ_WRITE_TOKEN=

# Auth.js
# 32文字以上のランダム文字列。`openssl rand -base64 32` で生成できます
AUTH_SECRET=

# 管理者ログイン用（seed実行時に1人だけ登録されます）
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-seeding
