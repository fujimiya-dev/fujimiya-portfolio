# Neon Postgres (VercelのStorageタブ → Marketplace → Neon で作成すると自動で発行される)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (画像アップロード用。Storage タブで作成)
BLOB_READ_WRITE_TOKEN=

# Auth.js
# 32文字以上のランダム文字列。`openssl rand -base64 32` で生成できます
AUTH_SECRET=

# 管理者ログイン用（seed実行時に1人だけ登録されます）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERNAME=
NEXTAUTH_URL=

# お問い合わせフォーム送信用（Resend: https://resend.com）
# 無料枠あり。サインアップ後、API Keys画面で発行できます
RESEND_API_KEY=
# フォームの内容を届けたい、あなた自身の実際のメールアドレス
CONTACT_TO_EMAIL=